# LLM
LLM_PROVIDER=groq                      # groq | gemini
GROQ_API_KEY=                          # https://console.groq.com/keys
GEMINI_API_KEY=                        # optional fallback provider
LLM_MODEL_HEAVY=openai/gpt-oss-120b    # extraction + question generation
LLM_MODEL_LIGHT=openai/gpt-oss-20b     # ranking, signals, flashcards
LLM_MODEL_ALT=qwen/qwen3.8-27b         # overflow when others are rate limited
LLM_DEV_CACHE=false                    # true = cache LLM responses on disk (dev only)

# Retrieval
ALLOW_PRIVATE_HOSTS=false              # true only for local fixture sites / batch tests

# Server only (not needed for `npm run evaluate`)
MONGODB_URI=
PORT=3000
CORS_ORIGIN=http://localhost:3000
